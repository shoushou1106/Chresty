<Page
    x:Class="Chresty.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea">
        <Grid
            RowDefinitions="Auto, Auto, Auto"
            ColumnDefinitions="Auto, Auto, *"
            Padding="10">
            <InfoBar
                Grid.ColumnSpan="2" Grid.Row="0"
                IsOpen="True"
                Severity="Warning"
                Title="Warning"
                Message="MUST NOT cheat" />
            <TextBlock Grid.ColumnSpan="2" Grid.Row="1" Text="临时放在这里 以后会改 别急"/>
            <Button x:Name="ChooseProfile" Grid.Column="0" Grid.Row="2" Content="select profile" Click="ChooseProfile_Click"/>
            <Button x:Name="ImportMod" Grid.Column="1" Grid.Row="2" Content="select mod" Click="ImportMod_Click" IsEnabled="False"/>
            <ProgressRing x:Name="ProgressRing" Grid.Column="2" Grid.RowSpan="3" IsActive="False"/>
        </Grid>
    </Grid>
</Page>
