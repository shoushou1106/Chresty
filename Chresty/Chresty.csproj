<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Chresty</RootNamespace>
    <ApplicationIcon>Assets\WindowIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win10-x86;win10-x64;win10-arm64</RuntimeIdentifiers>
    <PublishProfile>Properties\PublishProfiles\win10-$(Platform).pubxml</PublishProfile>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PackageCertificateKeyFile>Chresty_TemporaryKey.pfx</PackageCertificateKeyFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>True</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>True</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Auto</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <AppInstallerUri>https://www.penis.cum</AppInstallerUri>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="Assets\Logo.altform-lightunplated_targetsize-16.png" />
    <Content Remove="Assets\Logo.altform-lightunplated_targetsize-24.png" />
    <Content Remove="Assets\Logo.altform-lightunplated_targetsize-256.png" />
    <Content Remove="Assets\Logo.altform-lightunplated_targetsize-32.png" />
    <Content Remove="Assets\Logo.altform-lightunplated_targetsize-48.png" />
    <Content Remove="Assets\Logo.altform-unplated_targetsize-16.png" />
    <Content Remove="Assets\Logo.altform-unplated_targetsize-24.png" />
    <Content Remove="Assets\Logo.altform-unplated_targetsize-256.png" />
    <Content Remove="Assets\Logo.altform-unplated_targetsize-32.png" />
    <Content Remove="Assets\Logo.altform-unplated_targetsize-48.png" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\BadgeLogo.scale-100.png" />
    <None Remove="Assets\BadgeLogo.scale-125.png" />
    <None Remove="Assets\BadgeLogo.scale-150.png" />
    <None Remove="Assets\BadgeLogo.scale-200.png" />
    <None Remove="Assets\BadgeLogo.scale-400.png" />
    <None Remove="Assets\Logo.scale-100.png" />
    <None Remove="Assets\Logo.scale-125.png" />
    <None Remove="Assets\Logo.scale-150.png" />
    <None Remove="Assets\Logo.scale-200.png" />
    <None Remove="Assets\Logo.scale-400.png" />
    <None Remove="Assets\Logo.targetsize-16.png" />
    <None Remove="Assets\Logo.targetsize-16_altform-lightunplated.png" />
    <None Remove="Assets\Logo.targetsize-16_altform-unplated.png" />
    <None Remove="Assets\Logo.targetsize-24.png" />
    <None Remove="Assets\Logo.targetsize-24_altform-lightunplated.png" />
    <None Remove="Assets\Logo.targetsize-24_altform-unplated.png" />
    <None Remove="Assets\Logo.targetsize-256.png" />
    <None Remove="Assets\Logo.targetsize-256_altform-unplated.png" />
    <None Remove="Assets\Logo.targetsize-32.png" />
    <None Remove="Assets\Logo.targetsize-32_altform-lightunplated.png" />
    <None Remove="Assets\Logo.targetsize-48.png" />
    <None Remove="Assets\Logo.targetsize-48_altform-unplated.png" />
    <None Remove="Assets\SplashScreen.scale-100.png" />
    <None Remove="Assets\SplashScreen.scale-125.png" />
    <None Remove="Assets\SplashScreen.scale-150.png" />
    <None Remove="Assets\SplashScreen.scale-200.png" />
    <None Remove="Assets\SplashScreen.scale-400.png" />
    <None Remove="Assets\StoreLogo.scale-100.png" />
    <None Remove="Assets\StoreLogo.scale-125.png" />
    <None Remove="Assets\StoreLogo.scale-150.png" />
    <None Remove="Assets\StoreLogo.scale-200.png" />
    <None Remove="Assets\StoreLogo.scale-400.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls" Version="7.1.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="7.0.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.3.230724000" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="2.0.9" />
    <PackageReference Include="WinUIEx" Version="2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\fork\FrostyToolsuite\FrostyControls\FrostyControls.csproj" />
    <ProjectReference Include="..\..\fork\FrostyToolsuite\FrostyHash\FrostyHash.vcxproj" />
    <ProjectReference Include="..\..\fork\FrostyToolsuite\FrostyModManager\FrostyModManager.csproj" />
    <ProjectReference Include="..\..\fork\FrostyToolsuite\FrostyModSupport\FrostyModSupport.csproj" />
    <ProjectReference Include="..\..\fork\FrostyToolsuite\FrostyPlugin\FrostyCore.csproj" />
    <ProjectReference Include="..\..\fork\FrostyToolsuite\FrostySdk\FrostySdk.csproj" />
    <ProjectReference Include="..\Chresty.Core\Chresty.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
</Project>
