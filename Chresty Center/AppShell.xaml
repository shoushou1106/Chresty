<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Chresty_Center.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Chresty_Center"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

        <ShellContent
        Title="Mod"
        ContentTemplate="{DataTemplate local:ModPage}"
        Route="ModPage" />
        
    </TabBar>

</Shell>
